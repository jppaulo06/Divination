# Copy to .env and fill in the keys. Every variable below is required by
# Settings.load() — the API refuses to start if one is missing or empty.

OPENAI_API_KEY=
MARITACA_API_KEY=
# Note the name: Settings reads LANGCHAIN_API_KEY, not LANGSMITH_API_KEY.
LANGCHAIN_API_KEY=

# 0.0.0.0 so the port is reachable from outside the container.
HOST=0.0.0.0
PORT=8000

# JSON lists. The dev frontend is served on :3000; the prod profile serves
# it on :8080 and overrides this from docker-compose.yml.
ALLOWED_ORIGINS=["http://localhost:3000"]
ALLOWED_METHODS=["*"]
ALLOWED_HEADERS=["*"]
